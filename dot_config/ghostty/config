# Font settings
font-family = "ZedMono Nerd Font Mono"
font-size = 14

# Cursor
cursor-style = block
cursor-style-blink = false


# Appearance
theme = dark:catppuccin-frappe,light:catppuccin-latte

# Padding (macOS only)
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true


macos-titlebar-style = hidden
macos-option-as-alt = true
