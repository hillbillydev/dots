{
      "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "context_servers": {
        "mcp-server-context7": {
            "source": "extension",
            "enabled": true,
            "settings": {
                "context7_api_key": {{ .context7ApiKey | quote }}
            }
        },
        "mcp-server-github": {
            "source": "extension",
            "enabled": true,
            "settings": {
                "github_personal_access_token": {{ .githubMcpToken | quote }}
            }
        }
    },
    "agent": {
        "single_file_review": true,
        "auto_compact": {
            "enabled": true,
            "threshold": "85%"
        },
        "tool_permissions": {
            "default": "allow",
            "tools": {
                "terminal": {
                    "always_confirm": [
                        { "pattern": "\\bsudo\\b" },
                        {
                            "pattern": "\\bgit\\s+(push|commit|reset|clean|rebase|merge)\\b"
                        },
                        { "pattern": "\\brm\\s+.*(-r|-f|--recursive|--force)" }
                    ],
                    "always_deny": [
                        {
                            "pattern": "\\brm\\s+.*(/|~|\\$HOME|\\$\\{HOME\\})(/|\\s|$)"
                        }
                    ]
                },
                "edit_file": {
                    "always_confirm": [
                        { "pattern": "(^|/)\\.env" },
                        { "pattern": "(^|/)secrets?(/|\\.)" },
                        { "pattern": "\\.(pem|key|cert|crt)$" }
                    ]
                },
                "write_file": {
                    "always_confirm": [
                        { "pattern": "(^|/)\\.env" },
                        { "pattern": "(^|/)secrets?(/|\\.)" },
                        { "pattern": "\\.(pem|key|cert|crt)$" }
                    ]
                },
                "delete_path": {
                    "always_confirm": [{ "pattern": ".*" }]
                }
            }
        }
    },
    "theme": "Catppuccin Frappé",
    "icon_theme": "Catppuccin Frappé",
    "helix_mode": true,
    "ui_font_family": "BerkeleyMono Nerd Font Mono",
    "buffer_font_family": "BerkeleyMono Nerd Font Mono",
    "buffer_font_size": 14,
    "terminal": {
        "font_family": "BerkeleyMono Nerd Font Mono",
        "font_size": 14
    },
    "ssh_connections": [
        {
            "host": "devbox",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/hillbillydev/code/north"]
                },
                {
                    "paths": ["/home/hillbillydev/code/rowm"]
                },
                {
                    "paths": ["/home/hillbillydev/code/rowmos"]
                },
                {
                    "paths": ["/home/hillbillydev/code/lab"]
                },
                {
                    "paths": ["~/.local/share/chezmoi"]
                }
            ]
        }
    ],
    "auto_install_extensions": {
        "ansible": true,
        "docker-compose": true,
        "dockerfile": true,
        "elixir": true,
        "graphql": true,
        "html": true,
        "just": true,
        "mcp-server-context7": true,
        "mcp-server-github": true,
        "mcp-server-playwright": true,
        "relay": true,
        "terraform": true
    }
}
