{
      "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "context_servers": {
        "mcp-server-context7": {
            "enabled": true,
            "settings": {
                "context7_api_key": {{ .context7ApiKey | quote }}
            }
        },
        "mcp-server-github": {
            "enabled": true,
            "settings": {
                "github_personal_access_token": {{ .githubMcpToken | quote }}
            }
        },
        "mcp-server-playwright": {
            "enabled": true,
            "settings": {}
        },
        "shadcn-mcp-server": {
            "enabled": true,
            "settings": {}
        },
        "postgres-context-server": {
            "enabled": true,
            "settings": {}
        }
    },
    "agent": {
        "play_sound_when_agent_done": true,
        "single_file_review": true,
        "auto_compact": {
            "enabled": true,
            "threshold": "85%"
        },
        "tool_permissions": {
            "default": "confirm",
            "tools": {
                "read_file": {
                    "default": "allow"
                },
                "list_directory": {
                    "default": "allow"
                },
                "find_path": {
                    "default": "allow"
                },
                "grep": {
                    "default": "allow"
                },
                "diagnostics": {
                    "default": "allow"
                },
                "terminal": {
                    "default": "confirm",
                    "always_allow": [
                        {
                            "pattern": "^(npm|bun)\\s+(test|run\\s+(build|test|lint|check|format))\\b"
                        },
                        {
                            "pattern": "^mix\\s+(compile|test|format|credo|dialyzer)\\b"
                        },
                        {
                            "pattern": "^git\\s+(--no-pager\\s+)?(status|log|diff|show|branch)\\b"
                        },
                        { "pattern": "^(ls|pwd|date|whoami|uname)\\b" },
                        {
                            "pattern": "^(cat|sed|grep|rg|find|fd|wc|file)\\s"
                        },
                        { "pattern": "^chezmoi\\s+(diff|status|verify)\\b" }
                    ],
                    "always_confirm": [
                        { "pattern": "\\bsudo\\b" },
                        {
                            "pattern": "\\bgit\\s+(push|commit|reset|clean|rebase|merge)\\b"
                        },
                        { "pattern": "\\b(rm|mv|chmod|chown)\\b" },
                        { "pattern": "\\b(curl|wget)\\b" },
                        {
                            "pattern": "\\b(npm|pnpm|yarn|bun)\\s+(install|ci|publish|login|add|remove|uninstall|update)\\b"
                        },
                        {
                            "pattern": "^mix\\s+(deps\\.(get|update)|hex\\.publish|local\\.(hex|rebar))\\b"
                        },
                        {
                            "pattern": "^hex\\s+(publish|user\\s+auth)\\b"
                        }
                    ],
                    "always_deny": [
                        {
                            "pattern": "\\brm\\s+.*(-r|-f|--recursive|--force).*\\s(/|~|\\$HOME|\\$\\{HOME\\})(/|\\s|$)"
                        },
                        { "pattern": "\\bsudo\\s+rm\\b" },
                        {
                            "pattern": "\\bgit\\s+push\\s+.*(--force|-f)\\b"
                        }
                    ]
                },
                "edit_file": {
                    "default": "allow",
                    "always_confirm": [
                        { "pattern": "(^|/)\\.env" },
                        { "pattern": "(^|/)secrets?(/|\\.)" },
                        { "pattern": "\\.(pem|key|cert|crt)$" }
                    ]
                },
                "write_file": {
                    "default": "allow",
                    "always_confirm": [
                        { "pattern": "(^|/)\\.env" },
                        { "pattern": "(^|/)secrets?(/|\\.)" },
                        { "pattern": "\\.(pem|key|cert|crt)$" }
                    ]
                },
                "delete_path": {
                    "default": "confirm"
                }
            }
        }
    },
    "theme": "Catppuccin Frappé",
    "icon_theme": "Catppuccin Frappé",
    "helix_mode": true,
    "ui_font_family": "BerkeleyMono Nerd Font Mono",
    "buffer_font_family": "BerkeleyMono Nerd Font Mono",
    "buffer_font_features": {
        "calt": true
    },
    "buffer_font_size": 14,
    "terminal": {
        "font_family": "BerkeleyMono Nerd Font Mono",
        "font_features": {
            "calt": true
        },
        "font_size": 14
    },
    "ssh_connections": [
        {
            "host": "devbox",
            "args": [],
            "projects": [
                {
                    "paths": ["/home/hillbillydev/code/north"]
                },
                {
                    "paths": ["/home/hillbillydev/code/rowm"]
                },
                {
                    "paths": ["/home/hillbillydev/code/rowmos"]
                },
                {
                    "paths": ["/home/hillbillydev/code/lab"]
                },
                {
                    "paths": ["~/.local/share/chezmoi"]
                }
            ]
        }
    ],
    "auto_install_extensions": {
        "ansible": true,
        "docker-compose": true,
        "dockerfile": true,
        "elixir": true,
        "graphql": true,
        "github-actions": true,
        "html": true,
        "just": true,
        "log": true,
        "mcp-server-context7": true,
        "mcp-server-github": true,
        "mcp-server-playwright": true,
        "shadcn-mcp": true,
        "postgres-context-server": true,
        "relay": true,
        "terraform": true
    }
}
